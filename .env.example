# CityVision / SIH26124 Environment Configuration

# Database
DATABASE_URL=sqlite:///./sih26124.db
# For PostgreSQL / TimescaleDB:
# DATABASE_URL=postgresql://sih_user:sih_secure_pass@localhost:5432/sih26124

# Feature Flags (Default: false for zero-dependency standalone demo)
TIMESCALE_ENABLED=false
MINIO_ENABLED=false
MQTT_ENABLED=false
AUTH_ENABLED=false

# MinIO / Object Storage (Active when MINIO_ENABLED=true)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=cityvision-evidence

# MQTT Broker (Active when MQTT_ENABLED=true)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=cityvision

# Authentication (Active when AUTH_ENABLED=true)
JWT_SECRET=sih26124_super_secret_jwt_key_demo_only
JWT_LIFETIME_SECONDS=3600
